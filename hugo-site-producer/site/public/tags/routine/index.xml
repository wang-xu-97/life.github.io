    <item>
      <title>250911</title>
      <link>http://localhost:46139/life.github.io/life/250911/</link>
      <pubDate>Thu, 11 Sep 2025 09:40:28 +0800</pubDate>
      
      <guid>http://localhost:46139/life.github.io/life/250911/</guid>
      <description>&lt;h1 class=&#34;relative group&#34;&gt;记录 
    &lt;div id=&#34;记录&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%ae%b0%e5%bd%95&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: center&#34;&gt;&lt;/th&gt;
          &lt;th style=&#34;text-align: center&#34;&gt;程度&lt;/th&gt;
          &lt;th style=&#34;text-align: center&#34;&gt;原因&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;抑郁&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;低&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;焦虑&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;低&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;休息时间&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;00:10&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;游戏激情&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;睡眠质量&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;一般&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;晚睡&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;鼻炎程度&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;3/10&lt;/td&gt;
          &lt;td style=&#34;text-align: center&#34;&gt;晚睡，抵抗力弱&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;

&lt;h1 class=&#34;relative group&#34;&gt;思考 
    &lt;div id=&#34;思考&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e6%80%9d%e8%80%83&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;游戏激情&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;新游戏
&lt;ol&gt;
&lt;li&gt;操作简单、优化好、反馈快、爽感很足&lt;/li&gt;
&lt;li&gt;成就、图鉴、新武器、新构筑体验驱动&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;冲突
&lt;ol&gt;
&lt;li&gt;时间管理计划执行度低，效果差
&lt;ol&gt;
&lt;li&gt;忘记计时&lt;/li&gt;
&lt;li&gt;到点不休息、反复重启计时&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;锻炼计划未执行&lt;/li&gt;
&lt;li&gt;睡眠体验计划未执行&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;解决
&lt;ol&gt;
&lt;li&gt;明确体验目标&lt;/li&gt;
&lt;li&gt;冗余记录体验时长
&lt;ol&gt;
&lt;li&gt;大约1小时&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;明确分段短休长休
&lt;ol&gt;
&lt;li&gt;长休时点 65分钟，时长30min&lt;/li&gt;
&lt;li&gt;短休时点 23分钟，时长5min&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;调整计时循环
&lt;ol&gt;
&lt;li&gt;55 + 35 -&amp;gt; 65 + 30； 90min -&amp;gt; 95min&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;BG3&lt;/p&gt;</description>
      
    </item>
    
    <item>
      <title>250910</title>
      <link>http://localhost:46139/life.github.io/life/250910/</link>
      <pubDate>Wed, 10 Sep 2025 09:46:09 +0800</pubDate>
      
      <guid>http://localhost:46139/life.github.io/life/250910/</guid>
      <description>&lt;h1 class=&#34;relative group&#34;&gt;记录 
    &lt;div id=&#34;记录&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%ae%b0%e5%bd%95&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;p&gt;睡眠质量好，鼻炎程度低&lt;br&gt;
抑郁低&lt;br&gt;
焦虑低&lt;br&gt;
体重72&lt;/p&gt;

&lt;h1 class=&#34;relative group&#34;&gt;计划 
    &lt;div id=&#34;计划&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%ae%a1%e5%88%92&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;单车、洗澡&lt;/li&gt;
&lt;li&gt;睡眠安全感计划&lt;/li&gt;
&lt;/ol&gt;

&lt;h1 class=&#34;relative group&#34;&gt;体验要点 
    &lt;div id=&#34;体验要点&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e4%bd%93%e9%aa%8c%e8%a6%81%e7%82%b9&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;高亮视野键改到鼠标左键&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;侧键存档&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;不说&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;前方隐藏路线、隐藏收集不说&lt;/li&gt;
&lt;li&gt;任务路线、人物剧情不说&lt;/li&gt;
&lt;li&gt;地图规划、等级强度不说&lt;/li&gt;
&lt;li&gt;bd强度不说太详细&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;不做&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;不用一切bug&lt;/li&gt;
&lt;li&gt;不偷偷收集，有啥用啥&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;建议&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;bd&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;区分：
&lt;ol&gt;
&lt;li&gt;物理近战、远程&lt;/li&gt;
&lt;li&gt;施法者&lt;/li&gt;
&lt;li&gt;不吃装备的变身德鲁伊和武僧&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;推荐：
&lt;ol&gt;
&lt;li&gt;纯职奥法、月德、自然牧师、死亡牧师&lt;/li&gt;
&lt;li&gt;10诗2战、10诗2帕&lt;/li&gt;
&lt;li&gt;游侠集群开-&amp;gt;集群刺客&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;背包管理&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;勤用搜索器、分类排序&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;购买卷轴、投掷物、箭头、灵药、水瓶消耗品&lt;/p&gt;</description>
      
    </item>
    
    <item>
      <title>250909</title>
      <link>http://localhost:46139/life.github.io/life/250909/</link>
      <pubDate>Tue, 09 Sep 2025 09:09:35 +0800</pubDate>
      
      <guid>http://localhost:46139/life.github.io/life/250909/</guid>
      <description>&lt;h1 class=&#34;relative group&#34;&gt;今日计划 
    &lt;div id=&#34;今日计划&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e4%bb%8a%e6%97%a5%e8%ae%a1%e5%88%92&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;单车、洗澡&lt;/li&gt;
&lt;li&gt;换床单、执行睡前安全感计划
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th&gt;时间&lt;/th&gt;
          &lt;th&gt;行动项目&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;睡前30分钟&lt;/td&gt;
          &lt;td&gt;整理床铺，固定床单角落&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;睡前10分钟&lt;/td&gt;
          &lt;td&gt;进行5分钟简单拉伸放松&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;睡前5分钟&lt;/td&gt;
          &lt;td&gt;调整枕头位置，形成环绕感&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;入睡瞬间&lt;/td&gt;
          &lt;td&gt;深呼吸10次，放松&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;/li&gt;
&lt;/ol&gt;

&lt;h1 class=&#34;relative group&#34;&gt;记录 
    &lt;div id=&#34;记录&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%ae%b0%e5%bd%95&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;p&gt;焦虑低&lt;br&gt;
抑郁中&lt;br&gt;
体重72&lt;br&gt;
早起易怒冲动，睡眠质量差&lt;/p&gt;

&lt;h1 class=&#34;relative group&#34;&gt;思考 
    &lt;div id=&#34;思考&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e6%80%9d%e8%80%83&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;博得之门&lt;br&gt;
联机辅助bd：
&lt;ol&gt;
&lt;li&gt;前排德开
&lt;ol&gt;
&lt;li&gt;软刺-&amp;gt;诗帕：   16 16 14 8 10 8 -&amp;gt; 2德3软 -&amp;gt; 8级前排软刺（2德3软3刺） -&amp;gt; 9级~12级诗帕（2德1黑骑/王冠6剑刃诗 -&amp;gt; 2德2战2帕6剑刃诗）&lt;/li&gt;
&lt;li&gt;风暴牧-&amp;gt;水电法：10 16 14 8 8 16 -&amp;gt; 2德1牧 -&amp;gt; 5级：2德1牧2术 -&amp;gt; 7级洗点保持魅力施法：1法2德2牧2术 -&amp;gt; 2德2牧2法6术&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;刺开软刺：15 17 16 8 8 8 -&amp;gt; 3刺 -&amp;gt; 8级：5软3刺 -&amp;gt; 12级：5软4刺1德1法1术 凶蛮打手+属性提升/+1敏&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;/ol&gt;</description>
      
    </item>
    
    <item>
      <title>250908</title>
      <link>http://localhost:46139/life.github.io/life/250908/</link>
      <pubDate>Mon, 08 Sep 2025 15:36:29 +0800</pubDate>
      
      <guid>http://localhost:46139/life.github.io/life/250908/</guid>
      <description>&lt;h1 class=&#34;relative group&#34;&gt;今日计划 
    &lt;div id=&#34;今日计划&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e4%bb%8a%e6%97%a5%e8%ae%a1%e5%88%92&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;单车&lt;/li&gt;
&lt;li&gt;换床单枕套&lt;/li&gt;
&lt;li&gt;称重&lt;/li&gt;
&lt;li&gt;打扫&lt;/li&gt;
&lt;/ol&gt;

&lt;h1 class=&#34;relative group&#34;&gt;记录 
    &lt;div id=&#34;记录&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%ae%b0%e5%bd%95&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;p&gt;抑郁：中&lt;br&gt;
焦虑：中&lt;/p&gt;

&lt;h1 class=&#34;relative group&#34;&gt;思考 
    &lt;div id=&#34;思考&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e6%80%9d%e8%80%83&#34; aria-label=&#34;锚点&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h1&gt;
&lt;ol&gt;
&lt;li&gt;
&lt;p&gt;博得之门&lt;br&gt;
荣誉双人档玩得很累，反馈不足&lt;br&gt;
问题：&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;频繁洗点、能力变化，记忆不清&lt;/li&gt;
&lt;li&gt;强力bd输出要求苛刻，准备麻烦，资源规划不清晰，执着于低消耗不想短休长休&lt;/li&gt;
&lt;li&gt;自研bd实际效果矛盾、不理想
&lt;ol&gt;
&lt;li&gt;定身/非定身战斗/魅力主控，bd不能统一最优，中庸之道反馈不足&lt;br&gt;
&amp;ndash;&amp;gt; 定身支出魅调bd &amp;ndash;&amp;gt; 多打 &amp;ndash;&amp;gt; 2打动潮加速附动，多洛、火热之欲、恶毒短弓 &amp;ndash;&amp;gt; 最优解 5软1法1德4刺1术 （加速橡棍术魅力施法者）&lt;br&gt;
&amp;ndash;&amp;gt; 非定身低消耗魅调bd &amp;ndash;&amp;gt; 减重击骰 &amp;ndash;&amp;gt; 匕首、弓、头盔、咒剑、冠勇 &amp;ndash;&amp;gt; 最优解5软3刺3冠勇1咒/11冠勇1咒&lt;/li&gt;
&lt;li&gt;中期bd不能既要又要
&lt;ol&gt;
&lt;li&gt;想要2德+6剑咏就不能穿发光套&lt;/li&gt;
&lt;li&gt;想要低消耗bd偏弱，输出低&lt;/li&gt;
&lt;li&gt;想要强就要大量长休资源频繁长休&lt;br&gt;
调整：&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;辅助固定奥敏发光头箍套2德 &amp;ndash;&amp;gt; 2德6剑刃诗2战2帕 &amp;ndash;&amp;gt; 中期5级：2德2战1诗&lt;/li&gt;
&lt;li&gt;主控固定5软3刺4术舍弃减重击套，靠定身/受惊暴击 &amp;ndash;&amp;gt; 中期5级：1软3刺1咒 -&amp;gt; 5软4刺1咒 -&amp;gt; 5软4刺1咒1术 -&amp;gt; 5软4刺1德1法1术&lt;/li&gt;
&lt;li&gt;刷长休物资包&lt;/li&gt;
&lt;/ol&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;天国拯救&lt;br&gt;
低fov视角有点晕3d，需要耐心和高专注体验，状态不好、记忆差没法有好的体验&lt;/p&gt;</description>
      
    </item>
    
    <item>
